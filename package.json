{
  "name": "local-code-review",
  "version": "0.1.0",
  "description": "Review your local changes like a GitHub PR, before pushing. Optionally send comments to Claude Code.",
  "type": "module",
  "bin": {
    "lcr": "bin/lcr"
  },
  "scripts": {
    "build": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p ui/tsconfig.json",
    "test": "bun test",
    "postinstall": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "shiki": "1.24.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0"
  }
}
